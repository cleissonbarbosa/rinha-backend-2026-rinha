// =============================================================================
// Rinha de Backend 2026 - load balancer TCP na linguagem Rinha
//
// accept loop, round-robin entre BACKEND1/BACKEND2, fallback quando o backend
// escolhido nao conecta e relay bidirecional.
//
// O relay usa o builtin nativo `net_proxy`: o caminho de bytes roda inteiro em
// codigo compilado, sem passar pelo interpretador. O programa Rinha so decide
// para qual backend mandar a conexao - a logica de balanceamento continua aqui.
// =============================================================================

let backend1   = env("BACKEND1", "api1:8080");
let backend2   = env("BACKEND2", "api2:8080");
let fdBackend1 = env("FD_BACKEND1", "");
let fdBackend2 = env("FD_BACKEND2", "");
let listenAddr = env("LB_ADDR", "0.0.0.0:9999");
let cursor     = counter_new(0);
let chunkSize  = env_int("LB_CHUNK_SIZE", 65536);

// proxySockets: relay bidirecional nativo ate o EOF de qualquer lado.
let proxySockets = fn (client, backend) => {
  let done          = net_proxy(client, backend, chunkSize);
  let closedBackend = net_close(backend);
  net_close(client)
};

// useBackend: tenta `primary`; se a conexao falhar, cai para `fallback`.
let useBackend = fn (client, primary, fallback) => {
  let firstTry = net_connect_addr(primary);
  if (first(firstTry) == 1) {
    proxySockets(client, second(firstTry))
  } else {
    let secondTry = net_connect_addr(fallback);
    if (first(secondTry) == 1) {
      proxySockets(client, second(secondTry))
    } else {
      net_close(client)
    }
  }
};

// handoffClient: envia o FD aceito para a API via Unix socket; se ambos os
// handoffs falharem, cai para o proxy TCP tradicional.
let handoffClient = fn (client, primaryFd, primaryTcp, fallbackFd, fallbackTcp) => {
  let firstTry = net_fd_send_addr(primaryFd, client);
  if (firstTry == 1) {
    net_close(client)
  } else {
    let secondTry = net_fd_send_addr(fallbackFd, client);
    if (secondTry == 1) {
      net_close(client)
    } else {
      useBackend(client, primaryTcp, fallbackTcp)
    }
  }
};

// handleClient: round-robin par/impar entre os dois backends.
let handleClient = fn (client) => {
  let turn   = counter_next(cursor);
  let parity = turn - (turn / 2) * 2;
  if (str_len(fdBackend1) > 0) {
    if (parity == 0) {
      handoffClient(client, fdBackend1, backend1, fdBackend2, backend2)
    } else {
      handoffClient(client, fdBackend2, backend2, fdBackend1, backend1)
    }
  } else {
    if (parity == 0) {
      useBackend(client, backend1, backend2)
    } else {
      useBackend(client, backend2, backend1)
    }
  }
};

let listener = net_listen_addr(listenAddr);
let boot     = print("rinha lb (net_proxy) em " + listenAddr + " -> " + backend1 + ", " + backend2);
net_serve(listener, handleClient)
