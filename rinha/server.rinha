// =============================================================================
// Rinha de Backend 2026 - API completa escrita na linguagem Rinha
//
// Toda a logica de aplicacao roda aqui, em Rinha:
//   - parsing da request HTTP (request line, corpo apos CRLFCRLF)
//   - parsing do JSON da transacao
//   - vetorizacao: as 14 dimensoes normalizadas e quantizadas (escala 32767)
//   - voto kNN sobre os 5 vizinhos devolvidos pelo indice nativo
//   - montagem da resposta HTTP
//
// O interpretador so expoe primitivos de baixo nivel: sockets crus (net_*),
// bytes de string (str_*), variaveis de ambiente (env*) e o indice vetorial
// (`ivf_warmup`/`ivf_query`) - este apenas RECUPERA os 5 vizinhos mais proximos
// do conjunto de referencia; a vetorizacao e o voto continuam aqui em Rinha.
// =============================================================================

// ---- bytes uteis -----------------------------------------------------------
let q    = str_byte(34);   // aspas duplas "
let cr   = str_byte(13);
let lf   = str_byte(10);
let crlf = cr + lf;

// ---- listas (representacao do str_chars: (1,(h,t)) cons, (0,0) nil) --------
let isNil = fn (l) => { first(l) == 0 };
let hd    = fn (l) => { first(second(l)) };
let tl    = fn (l) => { second(second(l)) };

// ---- numeros ---------------------------------------------------------------
let pow10 = fn (n) => { if (n <= 0) { 1 } else { 10 * pow10(n - 1) } };
// readDigits: le digitos a partir de `l`; devolve { val, rest, n }
let readDigits = fn (l, acc, n) => {
  if (isNil(l)) { record { val: acc, rest: l, n: n } }
  else { let c = hd(l);
    if (c >= 48) { if (c <= 57) { readDigits(tl(l), acc * 10 + c - 48, n + 1) }
      else { record { val: acc, rest: l, n: n } } }
    else { record { val: acc, rest: l, n: n } } }
};
// readFrac: le ate 6 digitos da parte fracionaria, devolve em micros
let readFrac = fn (l, acc, count) => {
  if (isNil(l)) { acc * pow10(6 - count) }
  else { let c = hd(l);
    if (c >= 48) { if (c <= 57) {
        if (count < 6) { readFrac(tl(l), acc * 10 + c - 48, count + 1) }
        else { readFrac(tl(l), acc, count) } }
      else { acc * pow10(6 - count) } }
    else { acc * pow10(6 - count) } }
};
// parseNum: lista posicionada no valor -> numero em micros (valor * 1e6),
//           truncando a parte fracionaria em 6 digitos; `fallback` se vazio.
let parseNum = fn (l, fallback) => {
  let l1  = if (isNil(l)) { l } else { if (hd(l) == 34) { tl(l) } else { l } };
  let neg = if (isNil(l1)) { 0 } else { if (hd(l1) == 45) { 1 } else { 0 } };
  let l2  = if (neg == 1) { tl(l1) } else { l1 };
  let w   = readDigits(l2, 0, 0);
  if (w.n == 0) { fallback }
  else {
    let r = w.rest;
    let frac = if (isNil(r)) { 0 } else { if (hd(r) == 46) { readFrac(tl(r), 0, 0) } else { 0 } };
    let mag = w.val * 1000000 + frac;
    if (neg == 1) { 0 - mag } else { mag }
  }
};
// digitsAll: concatena todos os digitos de `l` num inteiro
let digitsAll = fn (l, acc) => {
  if (isNil(l)) { acc }
  else { let c = hd(l);
    if (c >= 48) { if (c <= 57) { digitsAll(tl(l), acc * 10 + c - 48) } else { acc } }
    else { acc } }
};

// ---- acesso a campos JSON (sobre strings cruas) ----------------------------
let regionAfterS = fn (body, key) => {
  let pos = str_index(body, key);
  if (pos < 0) { body } else { str_drop(body, pos + str_len(key)) }
};
let valueAfterS = fn (region, key) => {
  let pos = str_index(region, key);
  if (pos < 0) { "" }
  else {
    let after = str_drop(region, pos + str_len(key));
    let colon = str_index(after, ":");
    if (colon < 0) { "" } else { str_drop(after, colon + 1) }
  }
};
let getNumS = fn (region, key, fallback) => {
  let v = valueAfterS(region, key);
  if (str_len(v) == 0) { fallback }
  else { parseNum(str_chars(str_number_token(v)), fallback) }
};
let getStrS = fn (region, key) => {
  let v = valueAfterS(region, key);
  if (str_len(v) == 0) { "" } else { str_take_until(str_drop(v, 1), 34) }
};
let getBoolS = fn (region, key) => {
  let v = valueAfterS(region, key);
  if (str_len(v) == 0) { 0 }
  else { if (str_index(v, "true") == 0) { 1 } else { 0 } }
};

// ---- char/digito (sobre listas de str_chars) -------------------------------
let charAt  = fn (l, i) => {
  if (isNil(l)) { 0 } else { if (i == 0) { hd(l) } else { charAt(tl(l), i - 1) } }
};
let digit1  = fn (c) => { if (c >= 48) { if (c <= 57) { c - 48 } else { 0 } } else { 0 } };
let digitAt = fn (l, i) => { digit1(charAt(l, i)) };
let int2 = fn (l, i) => { digitAt(l, i) * 10 + digitAt(l, i + 1) };
let int4 = fn (l, i) => {
  digitAt(l, i) * 1000 + digitAt(l, i + 1) * 100 + digitAt(l, i + 2) * 10 + digitAt(l, i + 3)
};

// ---- datas -----------------------------------------------------------------
// daysFromCivil: dias desde 1970-01-01 (algoritmo de Howard Hinnant)
let daysFromCivil = fn (y0, m, d) => {
  let y   = if (m < 3) { y0 - 1 } else { y0 };
  let era = if (y < 0) { (y - 399) / 400 } else { y / 400 };
  let yoe = y - era * 400;
  let mp  = if (m > 2) { m - 3 } else { m + 9 };
  let doy = (153 * mp + 2) / 5 + d - 1;
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  era * 146097 + doe - 719468
};

// ---- vetorizacao -----------------------------------------------------------
// qd: normaliza e quantiza. valor = num/denom em [0,1]; devolve
//     round(clamp(valor) * 32767) com arredondamento "half up".
let qd = fn (num, denom) => {
  if (num <= 0) { 0 }
  else { if (num >= denom) { 32767 }
    else { (num * 65534 + denom) / (denom * 2) } }
};
// mccQ: risco do MCC ja quantizado (= round(risco * 32767)), default 0.50.
let mccQ = fn (code) => {
  if (code == 5411) { 4915  } else {
  if (code == 5812) { 9830  } else {
  if (code == 5912) { 6553  } else {
  if (code == 5944) { 14745 } else {
  if (code == 7801) { 26214 } else {
  if (code == 7802) { 24575 } else {
  if (code == 7995) { 27852 } else {
  if (code == 4511) { 11468 } else {
  if (code == 5311) { 8192  } else {
  if (code == 5999) { 16384 } else { 16384 } } } } } } } } } }
};

// sumList: soma os elementos de uma lista Rinha (os 5 rotulos do kNN)
let sumList = fn (l) => { if (isNil(l)) { 0 } else { hd(l) + sumList(tl(l)) } };

// ---- classify: corpo JSON cru -> contagem de fraudes nos 5 vizinhos (0..5) --
let classify = fn (body) => {
  fraud_count_json(body)
};

// ---- parsing da request HTTP -----------------------------------------------
// parseRequest: devolve record { st, method, path, body, rest }
//   st = 0 invalida ; 1 completa ; 2 precisa de mais bytes
let parseRequest = fn (buf) => {
  if (str_len(buf) > 262144) { record { st: 0 } }
  else { http_parse_request(buf) }
};
// readReq: acumula bytes do socket ate ter uma request completa
let readReq = fn (fd, buf) => {
  let p = parseRequest(buf);
  if (p.st == 1) { p }
  else { if (p.st == 0) { record { st: 0 } }
    else {
      let more = net_recv(fd, 8192);
      if (str_len(more) == 0) { record { st: 0 } }
      else { readReq(fd, buf + more) }
    } }
};

// ---- roteamento + loop keep-alive ------------------------------------------
let respScore = fn (n) => {
  if (n <= 0) { resp0 } else {
  if (n == 1)  { resp1 } else {
  if (n == 2)  { resp2 } else {
  if (n == 3)  { resp3 } else {
  if (n == 4)  { resp4 } else { resp5 } } } } }
};
let route = fn (method, path, body) => {
  if (method == mGET) {
    if (path == pReady) { respReady } else { resp404 }
  } else {
    if (method == mPOST) {
      if (path == pFraud) { respScore(classify(body)) }
      else { respScore(5) }
    } else { resp404 }
  }
};
let serveConn = fn (fd, carry) => {
  let p = readReq(fd, carry);
  if (p.st == 1) {
    let sent = net_send(fd, route(p.method, p.path, p.body));
    serveConn(fd, p.rest)
  } else {
    net_close(fd)
  }
};

// ---- constantes (chaves JSON, metodos, rotas, sequencias) ------------------
let crlf2       = crlf + crlf;

let kTransaction     = q + "transaction" + q;
let kCustomer        = q + "customer" + q;
let kMerchant        = q + "merchant" + q;
let kTerminal        = q + "terminal" + q;
let kAmount          = q + "amount" + q;
let kInstallments    = q + "installments" + q;
let kAvgAmount       = q + "avg_amount" + q;
let kTxCount         = q + "tx_count_24h" + q;
let kKmHome          = q + "km_from_home" + q;
let kIsOnline        = q + "is_online" + q;
let kCardPresent     = q + "card_present" + q;
let kMcc             = q + "mcc" + q;
let kRequestedAt     = q + "requested_at" + q;
let kTimestamp       = q + "timestamp" + q;
let kKmCurrent       = q + "km_from_current" + q;
let kId              = q + "id" + q;
let kKnownMerchants  = q + "known_merchants" + q;

let mGET   = "GET";
let mPOST  = "POST";
let pReady = "/ready";
let pFraud = "/fraud-score";

// ---- respostas HTTP precomputadas ------------------------------------------
let bScore = fn (approved, score) => {
  "{" + q + "approved" + q + ":" + approved + "," + q + "fraud_score" + q + ":" + score + "}"
};
let mkResp = fn (status, body) => {
  "HTTP/1.1 " + status + crlf
    + "Content-Type: application/json" + crlf
    + "Connection: keep-alive" + crlf
    + "Content-Length: " + ("" + str_len(body)) + crlf
    + crlf + body
};

let bReady = "{" + q + "ready" + q + ":true}";
let b404   = "{" + q + "error" + q + ":" + q + "not_found" + q + "}";

let respReady = mkResp("200 OK", bReady);
let resp404   = mkResp("404 Not Found", b404);
let resp0 = mkResp("200 OK", bScore("true",  "0.0"));
let resp1 = mkResp("200 OK", bScore("true",  "0.2"));
let resp2 = mkResp("200 OK", bScore("true",  "0.4"));
let resp3 = mkResp("200 OK", bScore("false", "0.6"));
let resp4 = mkResp("200 OK", bScore("false", "0.8"));
let resp5 = mkResp("200 OK", bScore("false", "1.0"));

// ---- boot ------------------------------------------------------------------
let addr     = env("API_ADDR", "0.0.0.0:8080");
let fdAddr   = env("API_FD_SOCKET", "");
let warm     = ivf_warmup();
if (str_len(fdAddr) > 0) {
  let listener = net_fd_listen(fdAddr);
  let boot     = print("rinha api (fd) em " + fdAddr);
  net_fd_serve(listener, fn (cli) => { serveConn(cli, "") })
} else {
  let listener = net_listen_addr(addr);
  let boot     = print("rinha api (tcp) em " + addr);
  net_serve(listener, fn (cli) => { serveConn(cli, "") })
}
